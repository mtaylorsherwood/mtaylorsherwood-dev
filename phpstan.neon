includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: max

    ignoreErrors:
        -
            # Router::inertia() is a macro from inertiajs/inertia-laravel without a declared
            # return type, so PHPStan can't infer the Route instance returned for chaining.
            message: '#^Cannot call method name\(\) on mixed\.$#'
            path: routes/web.php
