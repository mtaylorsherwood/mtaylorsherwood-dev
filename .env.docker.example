# Copy to .env for `docker compose up` (see docker-compose.yml). This file is
# read both by Laravel and, for the vars below, by docker-compose.yml itself
# (Compose auto-loads the .env sitting next to it) — one file drives both.

APP_NAME="M Taylor-Sherwood"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8002

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Inertia server-side rendering. Left at its default (enabled) to match
# local Herd dev — no SSR server runs in this container either, so failures
# fall back to client-side rendering and get logged (see AppServiceProvider).
# INERTIA_SSR_ENABLED=true

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=mtsdev
DB_USERNAME=mtsdev
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
IMAGES_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Leave blank locally: IMAGES_DISK=public is used above, and pointing at the
# Cloudflare domain would break every image in the dev environment.
CLOUDFLARE_IMAGES_DOMAIN=

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Docker Compose only — not read by Laravel. Change these if the defaults
# clash with something else already running, or with the Cornerstone
# (8000/5173/3307), Festive Board (8001/5174/3308) or Lodge Pathway
# (8003/5175/3309) compose setups' own defaults. If you change APP_PORT,
# update APP_URL above to match.
# ---------------------------------------------------------------------------
APP_PORT=8002
VITE_PORT=5176
FORWARD_DB_PORT=3310
DB_ROOT_PASSWORD=secret
