APP_NAME="M Taylor-Sherwood"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://mtsdev.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Inertia server-side rendering. Leave on: all of this site's meta tags are
# emitted client-side by SeoHead.vue, so with SSR off, crawlers and link
# unfurlers get an empty body. Set to false only to deliberately opt out.
# INERTIA_SSR_ENABLED=true

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# IMAGES_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# The Cloudflare-proxied hostname used to build /cdn-cgi/image/ transformation
# URLs. MUST be set in production (to images.mtaylorsherwood.dev) and Image
# Transformations must be enabled on that Cloudflare zone - CloudflareImageUrl
# silently falls back to the plain storage URL when this is empty, so every
# url(400)/url(800)/url(1200) call returns the same full-resolution original
# with no resize and no WebP/AVIF re-encode. Nothing looks broken; the images
# are just several times larger than intended.
#
# Leave blank locally: local dev uses IMAGES_DISK=public, and pointing at the
# Cloudflare domain would break every image in the dev environment.
CLOUDFLARE_IMAGES_DOMAIN=

VITE_APP_NAME="${APP_NAME}"
